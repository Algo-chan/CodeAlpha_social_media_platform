# ==============================================================================
# Production Environment Variables Template (Zero-Cost Cloud Deployment)
# ==============================================================================
# Copy this file to .env or configure these keys in your cloud hosting provider
# (e.g., Render.com, Railway, Fly.io) environment settings.

# Server Configuration
PORT=3000
NODE_ENV=production

# Security: JWT Secret
# Generate a strong random key (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=generate_a_secure_long_random_string_here

# PostgreSQL Database (e.g. Neon.tech Free Tier)
# 1. Sign up for free at https://neon.tech (no credit card required).
# 2. Create a project and copy the connection string.
# 3. Make sure '?sslmode=require' is appended.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudinary Persistent Media Storage (Free Tier - 25GB/month)
# 1. Sign up for free at https://cloudinary.com (no credit card required).
# 2. From your Cloudinary Dashboard, copy Cloud Name, API Key, and API Secret.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS Policy (Optional: Defaults to '*' or restricted domain)
CORS_ORIGIN=*
